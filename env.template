# Copy this file to .env and add your API key:
#   cp env.template .env
#
# Drop in ANY one of the following — the server detects the provider from
# the key prefix. No key? The game runs in offline mode using built-in word
# packs.

# Easiest: one variable, any provider. Auto-detected from key prefix.
#   gsk_...      → Groq
#   sk-or-...    → OpenRouter
#   sk-ant-...   → Anthropic
#   sk-...       → OpenAI
LLM_API_KEY=

# OR — pin a specific provider with its conventional env var:
# GROQ_API_KEY=gsk_...
# OPENAI_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-or-...
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the default model for whichever provider you picked.
# Defaults: groq=llama-3.3-70b-versatile, openai=gpt-4o-mini,
#           openrouter=openai/gpt-4o-mini, anthropic=claude-haiku-4-5-20251001
# LLM_MODEL=

# Port (optional, defaults to 3000)
PORT=3000
